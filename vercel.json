{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/user-stories/evidence-exchange-monetize-deidentified-findings",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/user-stories/evidence-exchange-monetize-deidentified-findings/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    },
    {
      "source": "/user-stories/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    }
  ]
}
